+def _post_retry(url: str, *, attempts: int = 3, **kwargs) -> requests.Response:
+    """POST to an Apple setup endpoint, retrying transient network failures.
+
+    These endpoints intermittently stall the TLS handshake or drop the connection - often on the
+    first (cold) connection and much more often on a filtered line. Both callers below are safe to
+    repeat: they only mint or read tokens.
+    """
+    last: Exception | None = None
+    for attempt in range(1, attempts + 1):
+        try:
+            return requests.post(url, **kwargs)
+        except requests.RequestException as e:
+            last = e
+            logger.warning("%s: %s (attempt %d/%d)", url, e, attempt, attempts)
+            if attempt < attempts:
+                time.sleep(2 * attempt)
+    raise last
+
+
 def _basic(user: str, secret: str) -> str:
     return "Basic " + base64.b64encode(f"{user}:{secret}".encode()).decode()

